t"/></mxGeometry></mxCell><mxCell id="c9" value="PostgREST + PostgreSQL&lt;br&gt;(RLS, triggers)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="200" height="56" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="126" as="sourcePoint"/><mxPoint x="1040" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="1. PATCH {action:&#x27;cancel&#x27;} + session cookie" style="html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="160" as="sourcePoint"/><mxPoint x="440" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="2. getUser(): validate token" style="html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="210" as="sourcePoint"/><mxPoint x="740" y="210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="user" style="html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=open;dashed=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="250" as="sourcePoint"/><mxPoint x="440" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="3. select role from profiles (RLS: own row)" style="html=1;labelBackgroundColor=#ffffff;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="300" as="sourcePoint"/><mxPoint x="1040" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="role = student  ✓ requireAuth([&#x27;student&#x27;])" style="html=1;labelBackgroundColor=#f