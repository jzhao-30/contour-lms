ontSize=12;whiteSpace=wrap;" vertex="1" parent="c16"><mxGeometry x="0" y="212" width="380" height="26" as="geometry"/></mxCell><mxCell id="c25" value="created_at, updated_at  timestamptz" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c16"><mxGeometry x="0" y="238" width="380" height="26" as="geometry"/></mxCell><mxCell id="c26" value="«enum» user_role" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="200" height="82" as="geometry"/></mxCell><mxCell id="c27" value="student" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c26"><mxGeometry x="0" y="30" width="200" height="26" as="geometry"/></mxCell><mxCell id="c28" value="admin" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c26"><mxGeometry x="0" y="56" width="200" height="26" as="geometry"/></mxCell><mxCell id="c29" value="«enum» consultation_status" style="swimlane;html=1;startSize=30;fontStyle=1;fontSize=13;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="240" height="82" as="geometry"/></mxCell><mxCell id="c30" value="scheduled" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c29"><mxGeometry x="0" y="30" width="240" height="26" as="geometry"/></mxCell><mxCell id="c31" value="cancelled  (final, soft delete)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;whiteSpace=wrap;" vertex="1" parent="c29"><mxGeometry x="0" y="56" width="240" height="26" as="geometry"/></mxCell><mxCell id="c32" value="1 : 1  (ON DELETE CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=11;startArrow=ERmandOne;endArrow=ERmandOne;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="1 : N  (ON DELETE CASCADE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;fontSize=11;" edge="1" parent="1" source="c9" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;fontSize=11;" edge="1" parent="1" source="c16" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;Indexes&lt;/b&gt;&lt;br&gt;consultations (student_id, scheduled_at desc, id)&lt;br&gt;→ student dashboard + RLS + FK&lt;br&gt;&lt;br&gt;consultations (scheduled_at desc, id)&lt;br&gt;→ admin list, stable pagination&lt;br&gt;&lt;br&gt;CHECK: a consultation is never both cancelled and completed" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="340" height="170" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Functions &amp;amp; triggers&lt;/b&gt;&lt;br&gt;&lt;b&gt;on_auth_user_created&lt;/b&gt; → handle_new_user(): creates the profile, role is always &#x27;student&#x27;&lt;br&gt;&lt;br&gt;&lt;b&gt;is_admin()&lt;/b&gt; (SECURITY DEFINER): used by RLS, avoids recursion&lt;br&gt;&lt;br&gt;&lt;b&gt;consultations_enforce_rules&lt;/b&gt;: future dates only · cancelled is final · completed can&#x27;t be moved/cancelled · maintains updated_at" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="400" height="220" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Access control&lt;/b&gt;&lt;br&gt;&lt;b&gt;anon&lt;/b&gt;: no access&lt;br&gt;&lt;b&gt;profiles&lt;/b&gt;: read own (admin: all); update only first_name, last_name (role can&#x27;t be changed)&lt;br&gt;&lt;b&gt;consultations&lt;/b&gt;: student reads/inserts/updates own rows only; admin reads all, cannot write; no DELETE for anyone&lt;br&gt;Column GRANTs: insert (student_id, names, reason, scheduled_at) · update (scheduled_at, status, is_completed)" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;verticalAlign=top;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="830" y="540" width="380" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>